#. module: ai_text_rewrite
#: model_terms:ir.ui.view,arch_db:ai_text_rewrite.res_config_settings_view_form
msgid ""
"<i class=\"fa fa-exclamation-triangle\" title=\"Warning\"/>\n"
"                                This is a free, public, anonymous endpoint with no guarantees: it only handles short texts (a few hundred characters) and is meant for a quick trial, not for confidential data or daily use."
msgstr ""
"<i class=\"fa fa-exclamation-triangle\" title=\"Attenzione\"/>\n"
"                                Questo è un endpoint pubblico, anonimo e gratuito, senza alcuna garanzia: gestisce solo testi brevi (poche centinaia di caratteri) ed è pensato per una prova rapida, non per dati riservati né per l'uso quotidiano."

