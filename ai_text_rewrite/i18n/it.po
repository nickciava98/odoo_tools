#: model_terms:ir.ui.view,arch_db:ai_text_rewrite.res_config_settings_view_form
msgid "System prompt shared by every field with the AI rewrite button"
msgstr ""
"Prompt di sistema condiviso da tutti i campi con il pulsante di riscrittura "
"AI"

#. module: ai_text_rewrite
#: model_terms:ir.ui.view,arch_db:ai_text_rewrite.res_config_settings_view_form
msgid ""
"Texts already written in the same field are sent to the AI service as style "
"references"
msgstr ""
"I testi già scritti nello stesso campo vengono inviati al servizio AI come "
"riferimenti di stile"

#. module: ai_text_rewrite
#. odoo-javascript
#: code:addons/ai_text_rewrite/static/src/dialog/ai_rewrite_dialog.js:0
msgid "The AI rewrite request failed. Please try again."
msgstr "La richiesta di riscrittura AI non è riuscita. Riprova."

#. module: ai_text_rewrite
#. odoo-python
#: code:addons/ai_text_rewrite/models/ai_rewrite_service.py:0
msgid "The AI service returned an empty answer, please try again."
msgstr "Il servizio AI ha restituito una risposta vuota, riprova."

#. module: ai_text_rewrite
#. odoo-python
#: code:addons/ai_text_rewrite/models/ai_rewrite_service.py:0
msgid "The free AI service is currently unavailable, please try again later."
msgstr ""
"Il servizio AI gratuito non è al momento disponibile: riprova più tardi."

#. module: ai_text_rewrite
#. odoo-python
#: code:addons/ai_text_rewrite/models/ai_rewrite_service.py:0
msgid ""
"The free AI service only accepts short texts (up to about %s characters, "
"including the shared system prompt). For longer texts, configure a provider "
"with an API key in Settings."
msgstr ""
"Il servizio AI gratuito accetta solo testi brevi (fino a circa %s caratteri,"
" compreso il prompt di sistema condiviso). Per testi più lunghi configura "
"nelle Impostazioni un provider con chiave API."

#. module: ai_text_rewrite
#. odoo-python
#: code:addons/ai_text_rewrite/models/ai_rewrite_service.py:0
msgid ""
"The free AI service refused the request: it is a shared public service with "
"no guarantees. Please try again later or configure a provider with an API "
"key in Settings."
msgstr ""
"Il servizio AI gratuito ha rifiutato la richiesta: è un servizio pubblico "
"condiviso e senza garanzie. Riprova più tardi oppure configura nelle "
"Impostazioni un provider con chiave API."

#. module: ai_text_rewrite
#. odoo-python
#: code:addons/ai_text_rewrite/models/ai_rewrite_service.py:0
msgid ""
"The text is HTML markup: keep the tags and only rewrite the visible content."
msgstr ""
"Il testo è markup HTML: mantieni i tag e riscrivi solo il contenuto "
"visibile."

#. module: ai_text_rewrite
#. odoo-python
#: code:addons/ai_text_rewrite/models/ai_rewrite_service.py:0
msgid "The text is too long to be rewritten (maximum %s characters)."
msgstr "Il testo è troppo lungo per essere riscritto (massimo %s caratteri)."

#. module: ai_text_rewrite
#. odoo-python
#: code:addons/ai_text_rewrite/models/ai_rewrite_service.py:0
msgid "There is no text to rewrite."
msgstr "Non c'è testo da riscrivere."

#. module: ai_text_rewrite
#. odoo-javascript
#: code:addons/ai_text_rewrite/static/src/dialog/ai_rewrite_dialog.xml:0
msgid ""
"This text will be sent to the AI service configured in Settings to be "
"rewritten."
msgstr ""
"Questo testo verrà inviato al servizio AI configurato nelle Impostazioni per"
" essere riscritto."

#. module: ai_text_rewrite
#. odoo-python
#: code:addons/ai_text_rewrite/controllers/main.py:0
msgid "You do not have access to this feature."
msgstr "Non hai accesso a questa funzione."
